{
  "name": "agent-black-box",
  "version": "0.8.0-dev.0",
  "private": true,
  "description": "Local AI agent with enforced tool policies, pre-execution auditing and a live security dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "agent": "node examples/run-agent.mjs",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node src/mcp-gateway.mjs",
    "mcp:smoke": "node examples/mcp-smoke.mjs",
    "mcp:approval": "node examples/mcp-smoke.mjs --approval",
    "test:mcp-sdk": "node --test tests/mcp-sdk-interoperability.mjs",
    "mcp:modern": "node examples/mcp-modern-smoke.mjs",
    "audit:verify": "node src/audit-cli.mjs verify",
    "audit:seal": "node src/audit-cli.mjs seal",
    "mcp:isolation": "node examples/mcp-isolation-check.mjs",
    "anchor:export": "node src/checkpoint-cli.mjs export",
    "anchor:receive": "node src/checkpoint-cli.mjs receive",
    "anchor:compare": "node src/checkpoint-cli.mjs compare",
    "anchor:ledger": "node src/checkpoint-cli.mjs ledger",
    "mcp:mac-probe": "node examples/mcp-macos-probe.mjs",
    "mcp:mac-crash": "node examples/mcp-macos-crash.mjs",
    "mcp:mac-bundle-probe": "node examples/mcp-macos-probe.mjs --bundle",
    "mcp:mac-xpc-probe": "node examples/mcp-macos-xpc-probe.mjs",
    "mcp:mac-xpc-notes": "node examples/mcp-macos-xpc-notes.mjs",
    "mcp:mac-xpc-node-bridge": "node examples/mcp-macos-xpc-node-bridge.mjs",
    "mcp:mac-xpc-durable": "node examples/mcp-macos-xpc-durable.mjs",
    "mcp:mac-xpc-authority": "node examples/mcp-macos-xpc-authority.mjs",
    "mcp:mac-xpc-mcp-acceptance": "node examples/mcp-macos-xpc-mcp-acceptance.mjs"
  },
  "license": "MIT"
}
